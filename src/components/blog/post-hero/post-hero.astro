---
import type { CollectionEntry } from "astro:content";
import { formatPostDate } from "../../../lib/blog";
interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { title, post_hero, date_modified } = post.data;
const { heading, image, image_alt, author, author_url, date } = post_hero;
---

<header class="post-header">
  <img class="post-image" src={image} alt={image_alt} width="1200" height="800"
    loading="eager" fetchpriority="high" decoding="async"
    data-editable="image" data-prop-src="post_hero.image" data-prop-alt="post_hero.image_alt" />
  <h1 data-editable="text" data-prop="post_hero.heading">{heading || title}</h1>
  <div class="post-byline">
    <span>By {author_url ? <a href={author_url} rel="author"><span data-editable="text" data-prop="post_hero.author">{author}</span></a> : <span data-editable="text" data-prop="post_hero.author">{author}</span>}</span>
    <span aria-hidden="true">·</span>
    <span>Published <time datetime={new Date(date).toISOString()}>{formatPostDate(date)}</time></span>
    {date_modified && <span>Updated <time datetime={new Date(date_modified).toISOString()}>{formatPostDate(date_modified)}</time></span>}
  </div>
</header>
