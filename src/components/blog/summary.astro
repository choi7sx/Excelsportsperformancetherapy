---
import type { CollectionEntry } from "astro:content";
import Icon from "../ExcelIcon.astro";
import { formatPostDate } from "../../lib/blog";
interface Props extends CollectionEntry<"blog"> { loading?: "eager" | "lazy"; priority?: boolean }
const { data, id, loading = "lazy", priority = false } = Astro.props;
const { title, excerpt, thumb_image_path, thumb_image_alt, post_hero } = data;
---

<article class="blog-card">
  <a class="blog-card-link" href={`/blog/${id}/`}>
    <div class="blog-card-image">
      <img src={thumb_image_path || post_hero.image} alt={thumb_image_alt || post_hero.image_alt}
        width="1200" height="800" loading={loading} fetchpriority={priority ? "high" : "auto"} decoding="async" />
    </div>
    <div class="blog-card-copy">
      <p class="blog-meta"><time datetime={new Date(post_hero.date).toISOString()}>{formatPostDate(post_hero.date)}</time></p>
      <h2>{title}</h2>
      {excerpt && <p class="blog-excerpt">{excerpt}</p>}
      <span class="blog-read">Read article <Icon size={18} /></span>
    </div>
  </a>
</article>
