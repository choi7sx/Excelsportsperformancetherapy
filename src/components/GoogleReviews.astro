---
import { googleReviewsUrl } from "../lib/google-reviews";
const starPath = "m10 1.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8-4.3-4.1 5.9-.9Z";
---

<div class="google-reviews">
  <a class="google-reviews-link" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer"
    aria-label="5.0 out of 5 stars · 23 verified Google reviews. Read reviews (opens in a new tab)">
    <svg class="review-stars" width="104" height="20" viewBox="0 0 112 20" aria-hidden="true">
      {Array.from({ length: 5 }, (_, i) => <path d={starPath} transform={`translate(${i * 23} 0)`} />)}
    </svg>
    <span class="review-summary"><strong>5.0</strong><span class="review-separator" aria-hidden="true">·</span><span class="review-count">23 verified Google reviews</span></span>
  </a>
</div>

<style>
  .google-reviews-link { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; min-height: 48px; max-width: 100%; padding-block: 4px; color: var(--ink); border-radius: var(--radius); font-size: var(--text-small); line-height: 1.5; }
  .review-stars { flex-shrink: 0; fill: var(--blue); }
  .review-summary { display: inline-flex; align-items: baseline; gap: 8px; }
  .review-summary strong { font-size: inherit; font-weight: var(--weight-semibold); }
  .google-reviews-link:hover .review-count { color: var(--blue); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 600px) {
    .google-reviews-link { gap: 6px 8px; font-size: 13px; }
    .review-stars { width: 84px; }
    .review-summary { gap: 6px; }
  }
</style>
