---
import Layout from "../../layouts/ExcelLayout.astro";
import Icon from "../../components/ExcelIcon.astro";
import { services, bookingUrl, consultUrl, faqs } from "../../data/excel";
import { serviceGuides } from "../../data/service-guides";
import "../../styles/service-pages.css";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
const guide = serviceGuides[service.slug];
const questions = [...guide.questions, faqs[3]];
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.description,
  provider: { "@id": "https://www.excelspt.com/#practice" },
  areaServed: "Nashville, TN",
  url: `https://www.excelspt.com/services/${service.slug}/`,
};
---

<Layout
  title={`${service.title} in Nashville | Excel Sports Performance Therapy`}
  description={`${service.description} Learn what to expect with Dr. Ethan Coghill in Old Hickory or Belle Meade.`}
  schema={schema}
>
  <div class="service-page">
    <section class="service-intro container" aria-labelledby="service-title">
      <nav class="service-breadcrumb" aria-label="Breadcrumb">
        <a href="/#services">All services</a><span aria-hidden="true">/</span><span aria-current="page">{service.title}</span>
      </nav>
      <div class="service-intro-grid">
        <div>
          <span class="eyebrow">{service.title}</span>
          <h1 id="service-title">{service.intro}</h1>
          <p class="service-lead">{service.detail}</p>
        </div>
        <img
          class="service-hero-image"
          src={guide.heroImage.src}
          alt={guide.heroImage.alt}
          width="960"
          height="1100"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="service-meta">
        <span><Icon name="pin" size={16} /> Old Hickory & Belle Meade</span>
        <a href="#what-to-expect">What to expect <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="service-overview container" aria-labelledby="service-fit-title">
      <div>
        <span class="eyebrow">IS THIS FOR YOU?</span>
        <h2 id="service-fit-title">{guide.overview}</h2>
        <p>{service.fit}</p>
        <ul class="service-situations">
          {guide.situations.map((situation) => <li><Icon name="check" size={18} /><span>{situation}</span></li>)}
        </ul>
      </div>
      <aside class="service-included">
        <span class="service-icon"><Icon name={service.icon} size={28} /></span>
        <h3>What your care can include</h3>
        <ul>{service.items.map((item) => <li>{item}</li>)}</ul>
        <p>Your evaluation helps Ethan recommend the right approach for you.</p>
      </aside>
    </section>

    <section class="service-learning container" aria-labelledby="service-care-title">
      <div class="service-section-heading">
        <span class="eyebrow">A CLOSER LOOK</span>
        <h2 id="service-care-title">How {service.title.toLowerCase()} works.</h2>
      </div>
      {guide.focus.map((focus, index) => (
        <article class="service-learning-row">
          <div><span class="service-row-number">0{index + 1}</span><h3>{focus.title}</h3></div>
          <div><p>{focus.description}</p></div>
        </article>
      ))}
    </section>

    <section id="what-to-expect" class="service-expect" aria-labelledby="service-expect-title">
      <div class="container">
        <div class="service-expect-heading">
          <div><span class="eyebrow">WHAT TO EXPECT</span><h2 id="service-expect-title">Start with clarity.</h2></div>
          <p>{service.expectation}</p>
        </div>
        <ol class="service-steps">
          <li><span class="eyebrow">01 / YOUR STORY</span><h3>Talk about your goals.</h3><p>Share what is bothering you, how you train, and what you want to do more comfortably.</p></li>
          <li><span class="eyebrow">02 / YOUR EVALUATION</span><h3>Understand your starting point.</h3><p>Your 60-minute first visit looks at your movement and where pain or limitations show up.</p></li>
          <li><span class="eyebrow">03 / YOUR NEXT STEP</span><h3>Discuss a path forward.</h3><p>Ethan recommends a care path. Ask about the plan, the commitment, and what to work on next.</p></li>
        </ol>
      </div>
    </section>

    <section class="service-questions container" aria-labelledby="service-questions-title">
      <div><span class="eyebrow">GOOD QUESTIONS. CLEAR ANSWERS.</span><h2 id="service-questions-title">Before you begin.</h2><p>Have a question about your situation?</p><a class="text-link" href={consultUrl}>Free Consultation <Icon size={17} /></a></div>
      <div class="faq-list">
        {questions.map((faq) => <details name="service-faq"><summary>{faq.question}<span class="faq-plus" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>)}
      </div>
    </section>

    <section class="service-next container" aria-labelledby="service-next-title">
      <div><span class="eyebrow">WHEN YOU’RE READY</span><h2 id="service-next-title">{guide.nextStep}</h2><p>You don’t need to have it all figured out. Your evaluation is where we find your starting point together.</p></div>
      <div class="service-next-actions"><a class="button" href={bookingUrl} data-booking>Book an evaluation <Icon size={18} /></a><a class="text-link" href={consultUrl}>Free Consultation <Icon size={16} /></a></div>
    </section>

    <nav class="service-explore container" aria-label="Other services">
      <span class="eyebrow">EXPLORE OTHER SERVICES</span>
      <div>{services.filter((s) => s.slug !== service.slug).map((s) => <a href={`/services/${s.slug}/`}><div><strong>{s.title}</strong><span>{s.tagline}</span></div><Icon size={21} /></a>)}</div>
    </nav>
  </div>
</Layout>
