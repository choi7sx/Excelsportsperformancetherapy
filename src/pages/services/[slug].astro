---
import Layout from "../../layouts/ExcelLayout.astro";
import Icon from "../../components/ExcelIcon.astro";
import { services, bookingUrl, consultUrl } from "../../data/excel";
import { serviceGuides } from "../../data/service-guides";
import "../../styles/service-pages.css";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
const guide = serviceGuides[service.slug];
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.description,
  provider: { "@id": "https://www.excelspt.com/#practice" },
  areaServed: "Nashville, TN",
  url: `https://www.excelspt.com/services/${service.slug}/`,
};
---

<Layout
  title={`${service.title} in Nashville | Excel Sports Performance Therapy`}
  description={`${service.description} Learn what to expect with Dr. Ethan Coghill in Old Hickory or Belle Meade.`}
  schema={schema}
>
  <div class="service-page">
    <section class="service-intro container" aria-labelledby="service-title">
      <nav class="service-breadcrumb" aria-label="Breadcrumb">
        <a href="/#services">All services</a><span aria-hidden="true">/</span><span aria-current="page">{service.title}</span>
      </nav>
      <div class="service-intro-grid">
        <div>
          <span class="eyebrow">{service.title}</span>
          <h1 id="service-title">{service.intro}</h1>
          <p class="service-lead">{service.detail}</p>
        </div>
        <img
          class="service-hero-image"
          src={guide.heroImage.src}
          alt={guide.heroImage.alt}
          width="960"
          height="1100"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="service-meta">
        <span><Icon name="pin" size={16} /> Old Hickory & Belle Meade</span>
        <a href="#service-fit-title">Is this for you? <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="service-overview container" aria-labelledby="service-fit-title">
      <div class="service-fit">
        <span class="eyebrow">IS THIS FOR YOU?</span>
        <h2 id="service-fit-title">{guide.overview}</h2>
        <p>{guide.fitEmphasis
          ? guide.fit.split(guide.fitEmphasis).map((part, index) => (
              <>{index > 0 && <strong>{guide.fitEmphasis}</strong>}{part}</>
            ))
          : guide.fit}</p>
      </div>
      <aside class="service-included" aria-labelledby="service-included-title">
        <div class="service-included-heading">
          <span class="service-icon"><Icon name={service.icon} size={28} /></span>
          <h3 id="service-included-title">What your care can include</h3>
        </div>
        <p>{guide.includedEmphasis
          ? guide.included.split(guide.includedEmphasis).map((part, index) => (
              <>{index > 0 && <strong>{guide.includedEmphasis}</strong>}{part}</>
            ))
          : guide.included}</p>
        {guide.includedItems && (
          <ul>{guide.includedItems.map((item) => <li>{item}</li>)}</ul>
        )}
        {guide.includedNote && <p>{guide.includedNote}</p>}
        {guide.progression && (
          <div class="service-progression">
            <div class="service-progression-step">
              <Icon name="frown" size={32} />
              <span>{guide.progression.from}</span>
            </div>
            <Icon class="service-progression-arrow" size={28} />
            <div class="service-progression-step service-progression-goal">
              <Icon name="smile" size={32} />
              <span>{guide.progression.to}</span>
            </div>
          </div>
        )}
      </aside>
    </section>

    <section class="service-next container" aria-labelledby="service-next-title">
      <div><span class="eyebrow">WHEN YOU’RE READY</span><h2 id="service-next-title">{guide.nextStep}</h2><p>You don’t need to have it all figured out. Your evaluation is where we find your starting point together.</p></div>
      <div class="service-next-actions"><a class="button" href={bookingUrl} data-booking>Book an evaluation <Icon size={18} /></a><a class="text-link" href={consultUrl}>Free Consultation <Icon size={16} /></a></div>
    </section>

    <nav class="service-explore" aria-label="Other services">
      <div class="container">
        <span class="eyebrow">EXPLORE OTHER SERVICES</span>
        <div class="service-explore-links">{services.filter((s) => s.slug !== service.slug).map((s) => <a href={`/services/${s.slug}/`}><div><strong>{s.title}</strong><span>{s.tagline}</span></div><Icon size={21} /></a>)}</div>
      </div>
    </nav>
  </div>
</Layout>
