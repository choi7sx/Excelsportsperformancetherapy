---
import Layout from "../layouts/ExcelLayout.astro";
import Icon from "../components/ExcelIcon.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import { googleReviewsUrl } from "../lib/google-reviews";
import { bookingUrl, consultUrl, services, faqs, locations } from "../data/excel";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
const reviews = [
  {
    quote: "Dr. Ethan is amazing - from listening, to treating, to educating, to developing a plan, he is engaged in his patient’s care. He truly does have a passion for it. Process was simple from making the initial appointment to getting in the office. Communication is thorough. Highly recommend!",
    name: "Katie Sasser",
    rating: 5,
  },
  {
    quote: "Dr. Coghill is my personal hero! I first went to see him for a very painful “popped rib head” and I left my first appointment with the rib back in place! I continued semi-monthly, then, monthly visits to develop continued preventive measures. I now have the tools to assure this doesn’t continue to happen, and, with Dr. Coghill’s incredibly accurate assessment of my entire spine and back, he also COMPLETELY eliminated my lower back pain, that I assumed was just part of the aging process. His knowledge, assessment skills and healing methods are first-rate! I highly recommend his services and look forward to utilizing his new personal and small group personal training.",
    name: "Diane Garrison",
    rating: 5,
    expandable: true,
  },
  {
    quote: "Dr. Ethan helped me a great deal with an injury that wasn’t improving. He tailored care specific to my needs and helped me get back to the gym with detailed, scaling plans. He is highly knowledgeable and has a genuine interest in helping people recover. Highly recommended!",
    name: "Edward Gibson",
    rating: 5,
    expandable: true,
  },
];
---

<Layout schema={faqSchema}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <span class="eyebrow">Chiropractic & sports rehab · Old Hickory and Belle Meade, TN</span>
      <h1 id="hero-title">Get back to<br /><span>moving well.</span></h1>
      <p class="hero-description">
        One-on-one chiropractic care, rehab, and performance coaching with
        Dr. Ethan Coghill. A plan for your body. More room for the things you love.
      </p>
      <div class="hero-actions">
        <a class="button" href={bookingUrl} data-booking>Book an evaluation <Icon size={18} /></a>
        <a class="text-link" href={consultUrl}>Free Consultation <Icon size={17} /></a>
      </div>
      <GoogleReviews />
    </div>
    <figure class="hero-visual">
      <img class="hero-image" src="/images/ethan-care.webp"
        alt="Dr. Ethan Coghill providing hands-on care to a patient at Excel"
        width="1000" height="1774" fetchpriority="high" />
    </figure>
  </section>

  <section id="reviews" class="reviews-section" aria-labelledby="reviews-title">
    <div class="container">
      <div class="reviews-heading">
        <h2 id="reviews-title">What patients say</h2>
        <a class="review-note" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer" aria-label="Read more reviews on Google Maps (opens in a new tab)">Read more reviews</a>
      </div>
      <div class="reviews-grid">
        {reviews.map((review, index) => (
          <figure class="review" data-review-reference={index === 0 ? true : undefined} data-review-expandable={review.expandable} data-expanded="false">
            {review.rating && <span class="review-rating" role="img" aria-label={`${review.rating} out of 5 stars`}>{"★".repeat(review.rating)}</span>}
            <blockquote><span id={`patient-review-${index}`} data-review-text>“{review.quote}”</span>{review.expandable && <span class="review-tail" hidden><span data-review-tail></span>{" "}<button class="review-toggle" type="button" aria-expanded="false" aria-controls={`patient-review-${index}`} aria-label={`Read more of ${review.name}’s review`} data-review-name={review.name}>Read More</button></span>}</blockquote>
            <figcaption>— {review.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="services" class="services-section section-space" aria-labelledby="services-title" data-section-anchor>
    <div class="container services-layout">
      <div class="section-intro">
        <span class="eyebrow">How we help</span>
        <h2 id="services-title">Services that we provide.</h2>
        <p>You don’t need to choose a service before booking. We’ll find your starting point together.</p>
      </div>
      <div class="services-list">
        {services.map((service) => (
          <a class="service-row" href={`/services/${service.slug}/`} aria-labelledby={`${service.slug}-title`}>
            <span class="service-icon" aria-hidden="true"><Icon name={service.icon} size={25} /></span>
            <div><h3 id={`${service.slug}-title`}>{service.title}</h3><p>{service.description}</p></div>
            <Icon size={23} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="locations" class="locations-section section-space" aria-labelledby="locations-title" data-section-anchor>
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">Visit Us</span><h2 id="locations-title">Two locations. Same personal care.</h2></div>
      </div>
      <div class="locations-grid">
        {locations.map((location) => (
          <article class="location-card">
            <h3>{location.name}</h3>
            <p class="location-venue">{location.venue}</p>
            <address>{location.address}<br />{location.city}</address>
            <p class="location-hours">{location.hours}</p>
            <div class="location-actions">
              <a class="text-link" href={location.booking} aria-label={`Book at ${location.name}`}>Book this location <Icon size={18} /></a>
              <a class="directions-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.address + ", " + location.city)}`}
                aria-label={`Get directions to ${location.name} (opens in a new tab)`} target="_blank" rel="noopener noreferrer">Directions ↗</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="meet-ethan" class="ethan-section section-space" aria-labelledby="ethan-title" data-section-anchor>
    <div class="container ethan-grid">
      <img class="ethan-photo" src="/images/ethan-detail.webp"
        alt="Dr. Ethan focused on a patient during a hands-on therapy session"
        width="720" height="820" loading="lazy" />
      <div class="ethan-copy">
        <span class="eyebrow">Meet your doctor</span>
        <h2 id="ethan-title">Good care starts with feeling heard.</h2>
        <p class="large-copy">Dr. Ethan Coghill</p>
        <p>Dr. Ethan brings chiropractic care, rehabilitation, and performance coaching together to help active people work toward their goals.</p>
        <p>Hands-on treatment, purposeful movement, and time to talk. Your care starts with understanding what matters to you.</p>
        <a class="text-link" href={consultUrl}>Free Consultation <Icon size={18} /></a>
      </div>
    </div>
  </section>

  <section id="faq" class="faq-section section-space" aria-labelledby="faq-title" data-section-anchor>
    <div class="container faq-grid">
      <div class="section-intro">
        <span class="eyebrow">A few helpful answers</span><h2 id="faq-title">Before you book.</h2>
        <p>Have another question? Let’s talk.</p>
        <a class="text-link" href="tel:+16153141508">(615) 314-1508 <Icon size={17} /></a>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details name="faq"><summary>{faq.question}<span class="faq-plus" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-cta" aria-labelledby="closing-title">
    <div class="container closing-grid">
      <div><span class="eyebrow">Let’s take the next step</span><h2 id="closing-title">More of what you love.<br />Start here.</h2><p>Book an evaluation, or talk with Dr. Ethan first.</p></div>
      <div class="closing-actions">
        <a class="button" href={bookingUrl} data-booking>Book an evaluation <Icon size={18} /></a>
        <a class="text-link" href={consultUrl}>Free Consultation <Icon size={17} /></a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initializeSectionAnchors } from "../scripts/section-anchors";
  import { initializeReviewCards } from "../scripts/review-cards";
  document.querySelectorAll<HTMLElement>(".reviews-grid").forEach(initializeReviewCards);
  initializeSectionAnchors();
</script>
