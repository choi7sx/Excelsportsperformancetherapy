# Browser key: restrict to your website domains and the required Google Maps APIs.
# Enable Maps JavaScript API + Places API (New) in a billing-enabled project.
PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Place ID for Excel Sports Performance Therapy at 3323 Old Hickory Blvd.
# Use Google's Place ID Finder; a Maps URL or hexadecimal CID is not a Place ID.
PUBLIC_GOOGLE_PLACE_ID=

# Optional GA4 override; the shared Analytics component defaults to Excel's public web-stream ID.
# Uncomment with a new ID to override, or leave the value empty to disable tracking.
# Tracking stays off in development and outside excelspt.com/www.excelspt.com.
# PUBLIC_GA_MEASUREMENT_ID=
